{
  "schema": "edith.policy.v1",
  "name": "streamvla-yam",
  "entrypoint": "policy.py:Policy",
  "control_hz": 15,
  "action_space": "joint_position",
  "config": {
    "server_url": "ws://127.0.0.1:8000",
    "expected_metadata": {
      "robot_type": "yam",
      "action_space": "joint_position",
      "arm_order": [
        "left",
        "right"
      ]
    },
    "chunk_size": 8,
    "image_size": 224,
    "timeout_s": 10,
    "max_action_age_s": 2,
    "max_joint_step_rad": 0.1,
    "max_gripper_step": 0.2,
    "instruction": "",
    "crop_size": 512,
    "invalid_gaze": "full",
    "speech_to_text": true,
    "speech_mode": "latest",
    "utterance_silence_s": 0.8,
    "max_utterance_s": 15,
    "speech_timeout_s": 60,
    "whisper_model": "small",
    "whisper_device": "auto",
    "whisper_compute_type": "default",
    "whisper_language": "en",
    "speech_channel": 0,
    "speech_min_chars": 2
  }
}
